{
  "name": "deckyhub-site",
  "description": "deckyhub.com: DeckyHub's website.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python devtools/build-site.py _site && python devtools/audit-site.py _site",
    "a11y": "node devtools/accessibility.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.js && python -m unittest discover -s tests"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright": "1.65.1",
    "qrcode-generator": "2.0.4",
    "typescript": "^7.0.2"
  }
}
